#
# A trailing `64` marks a function only the 64-bit builds import (the escape-sequence path, AF-D52); the Pentium build must not import it.
# Checked by hand against the Win32 reference's "Windows 95" column. No wide-character (...W) entry points.
advapi32.dll!GetUserNameA
advapi32.dll!RegCloseKey
advapi32.dll!RegOpenKeyExA
advapi32.dll!RegQueryValueExA
gdi32.dll!GetDeviceCaps
kernel32.dll!ExitProcess
kernel32.dll!GetCommandLineA
kernel32.dll!GetComputerNameA
kernel32.dll!GetConsoleMode 64
kernel32.dll!GetConsoleOutputCP 64
kernel32.dll!GetConsoleScreenBufferInfo
kernel32.dll!GetEnvironmentVariableA
kernel32.dll!GetFileType
kernel32.dll!GetModuleHandleA
kernel32.dll!GetProcAddress
kernel32.dll!GetStdHandle
kernel32.dll!GetSystemInfo
kernel32.dll!GetTickCount
kernel32.dll!GetVersionExA
kernel32.dll!GlobalMemoryStatus
kernel32.dll!SetConsoleMode 64
kernel32.dll!SetConsoleOutputCP 64
kernel32.dll!SetConsoleTextAttribute
kernel32.dll!WriteConsoleA
kernel32.dll!WriteFile
user32.dll!GetDC
user32.dll!GetSystemMetrics
user32.dll!ReleaseDC
